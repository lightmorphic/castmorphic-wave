{
  "name": "wave",
  "productName": "Castmorphic Wave",
  "version": "1.0.0",
  "description": "Turn a background image and an audio file into a YouTube-ready video with an animated waveform overlay.",
  "main": "src/main/main.js",
  "desktopName": "wave.desktop",
  "license": "GPL-3.0-or-later",
  "author": "Castmorphic (https://wave.castmorphic.com)",
  "homepage": "https://wave.castmorphic.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightmorphic/castmorphic-wave.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.castmorphic.wave",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "owner": "lightmorphic",
      "repo": "castmorphic-wave"
    },
    "artifactName": "Wave-${version}-${arch}.AppImage",
    "files": [
      "src/**/*",
      "assets/icon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "linux": {
      "target": "AppImage",
      "syncDesktopName": true,
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Turn an image and audio into a YouTube-ready waveform video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1"
  }
}
